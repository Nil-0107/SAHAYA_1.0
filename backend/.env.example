SAHAYA_ENV=production
# Required in production; use the managed database URL for the deployment.
SAHAYA_DATABASE_URL=
# Required in production; comma-separated HTTPS origins only.
SAHAYA_CORS_ORIGINS=https://your-frontend.example.com
SAHAYA_JWT_SECRET_KEY=
SAHAYA_JWT_ALGORITHM=HS256
SAHAYA_JWT_ISSUER=sahaya-api
SAHAYA_JWT_AUDIENCE=sahaya-web
SAHAYA_ACCESS_TOKEN_MINUTES=30
SAHAYA_REFRESH_TOKEN_DAYS=7
SAHAYA_REFRESH_COOKIE_SECURE=true

# Synthetic application data is never shown by normal runtime APIs. Enable it
# only for explicit local test fixtures when needed.
SAHAYA_INCLUDE_DEMO_DATA=false

# Server-side only. Never put this in frontend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# pyttsx3 is used for server-side text-to-speech. Browser/Gemini handles speech-to-text.

SAHAYA_UPLOAD_DIRECTORY=./uploads
SAHAYA_UPLOAD_MAX_BYTES=10485760
