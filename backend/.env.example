SAATHI_ENV=development
SAATHI_DATABASE_URL=sqlite:///./saathi.db
SAATHI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAATHI_JWT_SECRET_KEY=replace-with-a-long-random-secret
SAATHI_JWT_ALGORITHM=HS256
SAATHI_JWT_ISSUER=saathi-api
SAATHI_JWT_AUDIENCE=saathi-web
SAATHI_ACCESS_TOKEN_MINUTES=30
SAATHI_REFRESH_TOKEN_DAYS=7
SAATHI_REFRESH_COOKIE_SECURE=false

# Server-side only. Never put this in frontend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# pyttsx3 is used for server-side text-to-speech. Browser/Gemini handles speech-to-text.

SAATHI_UPLOAD_DIRECTORY=./uploads
SAATHI_UPLOAD_MAX_BYTES=10485760
