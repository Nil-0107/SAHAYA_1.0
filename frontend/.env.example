VITE_API_BASE_URL=https://api.your-production.example.com/api/v1
# Optional JSON array. No emergency resource is shown unless explicitly configured here.
VITE_IMMEDIATE_HELP_RESOURCES=[]
# Local test-role selection is intentionally disabled in production builds.
VITE_LOCAL_ROLE_LOGIN_ENABLED=false
# To enable local testing, set this flag to true in an ignored .env.development
# file and provide the five VITE_LOCAL_TEST_* email/password pairs from the
# development-only test-auth seed. These values are never used by production builds.
# Never place GEMINI_API_KEY or any other server credential in frontend env files.
